# Скопируйте этот файл в .env и заполните значения.
# .env нельзя коммитить в репозиторий.

# --- Telegram-бот -----------------------------------------------------------
# Токен от @BotFather.
BOT_TOKEN=123456789:AAH-REPLACE-WITH-YOUR-BOT-TOKEN

# Telegram ID пользователей, которым разрешён доступ, через запятую.
ALLOWED_USER_IDS=123456789,987654321

# Автоматически одобрять новых пользователей. По умолчанию выключено.
AUTO_APPROVE=false

# --- Telegram Bot API -------------------------------------------------------
# Облачный Bot API (по умолчанию).
TELEGRAM_API_BASE=https://api.telegram.org
# Пусто = файлы отдаёт облачный Bot API.
TELEGRAM_FILES_BASE=

# Локальный Bot API (опционально, профиль "local-bot-api"; см. README):
# TELEGRAM_API_BASE=http://telegram-bot-api:8081
# TELEGRAM_FILES_BASE=http://bot-api-files:80

# --- Веб-интерфейс и агентский HTTP API ------------------------------------
WEB_PORT=8000
AGENT_API_PORT=8765
# Пусто = агентский API работает без авторизации.
AGENT_TOKEN=

# --- Интерфейс --------------------------------------------------------------
# dark или light
THEME=dark

# --- Распознавание речи (sherpa-onnx, полностью офлайн) --------------------
# false = движок вообще не загружается.
ASR_ENABLED=true
# gigaam-v3-rnnt-punct (русский) или имя модели Whisper
ASR_MODEL=gigaam-v3-rnnt-punct

# --- Прочее -----------------------------------------------------------------
TZ=Europe/Moscow
